# ==============================================================================
# PLACEBO ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SNOWFLAKE WAREHOUSE CONNECTION (Real Cloud Database)
# ------------------------------------------------------------------------------
# NOTE: Uses your existing Snowflake account credentials.
# Cost: Depends on Snowflake compute credits (Free 30-day $400 Trial available from Snowflake)
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=YOUR_USERNAME
SNOWFLAKE_PASSWORD=YOUR_PASSWORD
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=PROD_DB
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_ROLE=ACCOUNTADMIN

# ------------------------------------------------------------------------------
# 2. LLM / GEMMA EXPLANATION ENGINE (Translates statistical package to prose)
# ------------------------------------------------------------------------------
# Provider Choice: "gemini" (Google AI Studio) OR "ollama" (Local self-hosted)
LLM_PROVIDER=gemini

# Google AI Studio API Key (Free tier available at https://aistudio.google.com)
# Cost: FREE tier gives generous requests per minute.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: Local Ollama (100% FREE, runs on your own machine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:27b

# ------------------------------------------------------------------------------
# 3. PLACEBO SERVER & LOCAL STORAGE SETTINGS
# ------------------------------------------------------------------------------
# SQLite DB for offline hypothesis caching / local ledger (100% FREE, built-in)
PLACEBO_SQLITE_PATH=./placebo_ledger.db
PLACEBO_API_HOST=0.0.0.0
PLACEBO_API_PORT=8000
PLACEBO_DEBUG=true

# ------------------------------------------------------------------------------
# 4. COCO / AI AGENT INTEGRATION (Optional Webhook / Key)
# ------------------------------------------------------------------------------
COCO_API_KEY=optional_coco_key
COCO_WEBHOOK_URL=http://localhost:8000/api/v1/audit/webhook
